name: Native desktop

on:
  push:
    branches: [mygo]
  pull_request:
    branches: [mygo]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: windows-latest
            script: build.bat
            shell: cmd
            artifact: ally-native-windows
            path: mygo/dist/ally-native.exe
          - os: macos-latest
            script: bash build-macos.sh
            artifact: ally-native-macos
            path: mygo/dist/ally-native-darwin-*
          - os: ubuntu-latest
            script: bash build-linux.sh
            artifact: ally-native-linux
            path: mygo/dist/ally-native-linux-amd64
    runs-on: ${{ matrix.os }}
    defaults:
      run:
        working-directory: mygo
    env:
      CGO_ENABLED: "0"
      GOMAXPROCS: "2"
      GOGC: "30"
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: mygo/go.mod
          cache: true
      - name: Test
        shell: bash
        run: go test -p 1 ./...
      - name: Check native UI
        shell: bash
        run: go run github.com/egoist/mygo/cmd/mygo@v0.7.1 vet .
      - name: Build
        shell: ${{ matrix.shell || 'bash' }}
        run: ${{ matrix.script }}
      - uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.artifact }}
          path: ${{ matrix.path }}
